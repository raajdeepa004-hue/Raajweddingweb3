# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MONGODB_URI: Connection string for MongoDB Atlas; required for persistent admin writes and media uploads
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority"

# MONGODB_DB: Database name for wedding invitation configuration & GridFS media
MONGODB_DB="wedding_invitation"

# ADMIN_UPLOAD_TOKEN: Secret token used to protect /api/media/upload and /api/invitation POST endpoints
ADMIN_UPLOAD_TOKEN="your_secure_admin_token_here"
